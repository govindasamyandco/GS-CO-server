rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "govindasamy.textitle@gmail.com";
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Anyone (customers & admin) can view products
      allow create, update, delete: if isAdmin(); // Only Admin can add/edit/delete products
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow create: if true; // Customers can submit orders
      allow read, update, delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
    }
  }
}
