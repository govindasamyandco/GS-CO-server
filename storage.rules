rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product-images/{imageId} {
      allow read: if true; // Public read for product images
      allow write: if request.auth != null 
                   && (request.auth.token.admin == true || request.auth.token.email.matches('(?i)^govindasamy\\.textile@gmail\\.com$'))
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
      allow delete: if request.auth != null 
                    && (request.auth.token.admin == true || request.auth.token.email.matches('(?i)^govindasamy\\.textile@gmail\\.com$'));
    }
  }
}
